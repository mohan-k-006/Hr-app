# Application Settings
PROJECT_NAME="Python AI Resume Screening System"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration
# Primary PostgreSQL URI (Uncomment & set credentials for production/Postgres setup):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/resume_screener"
# Fallback SQLite URI (Used automatically if Postgres is unreachable or omitted):
DATABASE_URL="sqlite:///./resume_screener.db"

# AI / LLM Configuration (Optional - standard NLP/TF-IDF runs fine without it)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
